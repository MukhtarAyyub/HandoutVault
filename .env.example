# Copy this file to .env and adjust values for your machine/deployment.
# .env is loaded automatically by config/settings.py (via python-dotenv)
# and is listed in .gitignore — never commit your real .env.

# A long, random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key

# True/False. Keep True for local development; ALWAYS False in production.
DJANGO_DEBUG=True

# Comma-separated. Add your production domain(s) when you deploy, e.g.
# DJANGO_ALLOWED_HOSTS=materials.example.edu,www.materials.example.edu
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins Django will trust for CSRF-protected POSTs
# (needed in production when served over HTTPS behind a custom domain).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://materials.example.edu

# Database connection. Omit entirely (or leave as sqlite) for zero-setup
# local development — Django will use db.sqlite3 in the project root.
# For PostgreSQL, use the URL your host gives you, e.g.:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

# Maximum size, in megabytes, for a single uploaded material.
MAX_MATERIAL_UPLOAD_MB=100

# IANA time zone used for all timestamps (upload dates, download logs).
DJANGO_TIME_ZONE=Africa/Lagos

# Only set to True if your host puts a reverse proxy in front of Django
# that terminates HTTPS itself AND is guaranteed to overwrite (not just
# pass through) the X-Forwarded-Proto header from the client — true for
# most free-tier PaaS hosts, false for a bare VPS with nothing in front
# of it. Getting this wrong on a non-proxied deployment lets a client
# spoof HTTPS status. See the comment above SECURE_PROXY_SSL_HEADER in
# config/settings.py, and SECURITY.md, "Force HTTPS", before enabling.
DJANGO_BEHIND_PROXY=False

# --- Cloudflare R2 (uploaded materials) --------------------------------------
# Leave ALL FOUR of these unset for local development — materials save to
# ./media/ on disk instead, no R2 account needed. Storage only switches to
# R2 once AWS_STORAGE_BUCKET_NAME and AWS_S3_ENDPOINT_URL are BOTH set (see
# DEPLOYMENT.md, "Cloudflare R2" for exactly where to get each value from
# the Cloudflare dashboard).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: only if you've mapped a custom domain (e.g. files.example.edu)
# to the bucket in Cloudflare — leave blank to use R2's own endpoint domain.
AWS_S3_CUSTOM_DOMAIN=
